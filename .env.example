# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dataflow
DATAFLOW_APP_PASSWORD=dataflow_app
DATABASE_URL=postgres://dataflow:dataflow@localhost:5433/dataflow
APP_DATABASE_URL=postgres://dataflow_app:dataflow_app@localhost:5433/dataflow

# ── Temporal / Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=dynamic-dag

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-bytes-random-hex
JWT_SECRET_PREVIOUS=

# ── SMTP (use mailhog locally) ────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@dataflow.local

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_PORT=4000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:3000/api/connectors/microsoft/callback

# ── Zendesk ───────────────────────────────────────────────────────────────────
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

# ── Google Service Account (connector) ───────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth token encryption (AES-256-GCM) ─────────────────────────────────────
# 32 random bytes, hex-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Temporal payload encryption (AES-256-GCM, defense-in-depth) ──────────────
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional: omit to run without Temporal payload encryption in dev.
TEMPORAL_PAYLOAD_ENCRYPTION_KEY=

# ── Worker keypair (Phase 6 KMS) ─────────────────────────────────────────────
# Generate with: node scripts/gen-worker-keypair.js
# The script writes secrets/worker-keypair.pem (private) + secrets/worker-keypair.pub
# Copy the printed WORKER_PUBLIC_KEY_PEM line here.
WORKER_PUBLIC_KEY_PEM=

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=dataflow
CLICKHOUSE_PASSWORD=dataflow
CLICKHOUSE_DB=dataflow

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Build ID (git SHA for worker versioning) ──────────────────────────────────
BUILD_ID=dev-local
