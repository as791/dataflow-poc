          {"activityType": "sink.s3", "contains": {"bucket": "eval-data", "key": "orders.json"}},
          {"activityType": "sink.kafka", "contains": {"topic": "orders.audit"}}
        ],
        "graph": {"minNodes": 4, "minOutDegree": 2}
      }
    },
    {
      "id": "branch-conditional-routes",
      "category": "branching",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-kafka", "eval-s3"],
      "request": {"prompt": "Using Kafka connection eval-kafka, consume topic payments and fork it: send records where status is failed to webhook https://hooks.example.test/failures and store all other records through S3 connection eval-s3 in bucket eval-data at payments/accepted.json."},
      "expect": {
        "activities": {"required": ["kafka.fetch", "flow.fork", "sink.webhook", "sink.s3"]},
        "graph": {"minOutDegree": 2, "minConditionalEdges": 1}
