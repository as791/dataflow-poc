    {
      "id": "branch-fork-two-sinks",
      "category": "branching",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-s3", "eval-kafka"],
      "request": {"prompt": "Read https://api.example.test/orders, fork the stream, write one branch through S3 connection eval-s3 to bucket eval-data key orders.json and publish the other through Kafka connection eval-kafka to topic orders.audit."},
      "expect": {
        "activities": {"required": ["http.fetch", "flow.fork", "sink.s3", "sink.kafka"]},
