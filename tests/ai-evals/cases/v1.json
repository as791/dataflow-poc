      "request": {"prompt": "Copy data from PostgreSQL connection warehouse-read into Snowflake connection snowflake-analytics table ANALYTICS.DAILY."},
      "expect": {"status": "needs_input"}
    },
    {
      "id": "ambiguous-write-mode",
      "category": "ambiguity",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["warehouse-read", "snowflake-analytics"],
