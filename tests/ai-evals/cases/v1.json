{
  "version": "1.0.0",
  "description": "DataFlow AI planner baseline corpus. All names and resources are synthetic.",
  "catalog": {
    "version": "coded-catalog-v1",
    "nodeTypes": {
      "source": ["zendesk.fetch", "gsheets.fetch", "gdrive.fetch", "excel.fetch", "http.fetch", "postgres.fetch", "mysql.fetch", "mongodb.fetch", "s3.fetch", "kafka.fetch", "sftp.fetch", "snowflake.fetch", "iceberg.fetch"],
      "transform": ["transform.map", "transform.filter", "transform.formula", "transform.select", "transform.rename", "transform.dedupe", "transform.flatten", "transform.parse", "transform.contract"],
      "fork": ["flow.fork"],
      "merge": ["flow.merge"],
      "sink": ["sink.postgres", "sink.clickhouse", "sink.mysql", "sink.mongodb", "sink.s3", "sink.kafka", "sink.sftp", "sink.snowflake", "sink.iceberg", "sink.gsheets", "sink.webhook", "sink.records"]
    },
    "commonConfigKeys": ["layer"],
    "configKeys": {
      "zendesk.fetch": ["connectionId", "subdomain", "resource"],
      "gsheets.fetch": ["connectionId", "spreadsheetId", "range", "keyColumn"],
      "gdrive.fetch": ["connectionId", "query"],
      "excel.fetch": ["connectionId", "driveId", "itemId", "sheetName", "keyColumn"],
      "http.fetch": ["connectionId", "url", "method", "recordsPath", "pagination", "paginationJson", "incremental", "incrementalJson", "auth", "authJson", "params", "pageSize", "headers"],
      "postgres.fetch": ["connectionId", "table", "cursorColumn", "cursorType", "columns", "pageSize", "syncMode"],
      "mysql.fetch": ["connectionId", "table", "cursorColumn", "cursorType", "columns", "pageSize", "syncMode"],
      "mongodb.fetch": ["connectionId", "collection", "cursorField", "pageSize", "syncMode"],
      "s3.fetch": ["connectionId", "bucket", "key", "format"],
      "kafka.fetch": ["connectionId", "topic", "startPosition", "pageSize", "includeMetadata"],
      "sftp.fetch": ["connectionId", "path", "format"],
      "snowflake.fetch": ["connectionId", "table", "cursorColumn", "columns", "pageSize"],
      "iceberg.fetch": ["connectionId", "namespace", "table"],
      "transform.map": ["expression"],
      "transform.filter": ["predicate"],
      "transform.formula": ["expression", "outputField"],
      "transform.select": ["expression"],
      "transform.rename": ["mapping"],
      "transform.dedupe": ["key", "keep", "scope"],
      "transform.flatten": ["delimiter", "maxDepth", "arrayPolicy"],
      "transform.parse": ["fields", "onError"],
      "transform.contract": ["schemaJson", "onViolation"],
      "sink.postgres": ["connectionId", "table", "conflictKey", "mode"],
      "sink.clickhouse": ["connectionId", "table"],
      "sink.mysql": ["connectionId", "table", "primaryKey", "mode"],
      "sink.mongodb": ["connectionId", "collection", "keyField", "mode"],
      "sink.s3": ["connectionId", "bucket", "key", "format"],
      "sink.kafka": ["connectionId", "topic", "keyField"],
      "sink.sftp": ["connectionId", "path", "format"],
      "sink.snowflake": ["connectionId", "table", "mode"],
      "sink.iceberg": ["connectionId", "namespace", "table", "mode"],
      "sink.gsheets": ["connectionId", "spreadsheetId", "sheetName", "writeMode", "includeHeader"],
      "sink.webhook": ["connectionId", "url"],
      "sink.records": ["collection"]
    }
  },
  "fixtures": {
    "version": "tenant-connectors-v1",
    "connectors": [
      {"provider": "postgres", "kind": "credential", "displayName": "warehouse-read"},
      {"provider": "mysql", "kind": "credential", "displayName": "shop-mysql"},
      {"provider": "mongodb", "kind": "credential", "displayName": "reporting-mongo"},
      {"provider": "snowflake", "kind": "credential", "displayName": "snowflake-analytics"},
      {"provider": "clickhouse", "kind": "credential", "displayName": "clickhouse-analytics"},
      {"provider": "http", "kind": "credential", "displayName": "eval-http"},
      {"provider": "s3", "kind": "credential", "displayName": "eval-s3"},
      {"provider": "sftp", "kind": "credential", "displayName": "eval-sftp"},
      {"provider": "kafka", "kind": "credential", "displayName": "eval-kafka"},
      {"provider": "iceberg", "kind": "credential", "displayName": "eval-iceberg"},
      {"provider": "google", "kind": "oauth", "displayName": "eval-google"},
      {"provider": "zendesk", "kind": "oauth", "displayName": "eval-zendesk"}
    ]
  },
  "cases": [
    {
      "id": "gen-http-filter-s3",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-http", "eval-s3"],
      "request": {"prompt": "Build a manual pipeline named Paid posts export. Use HTTP connection eval-http to read https://api.example.test/posts, keep records where userId equals 1, and use S3 connection eval-s3 to write JSON to bucket eval-data at key paid/posts.json."},
      "expect": {
        "activities": {"required": ["http.fetch", "transform.filter", "sink.s3"]},
        "configs": [
          {"activityType": "http.fetch", "contains": {"url": "https://api.example.test/posts"}},
          {"activityType": "sink.s3", "contains": {"bucket": "eval-data", "key": "paid/posts.json"}}
        ],
        "trigger": {"type": "manual"}
      }
    },
    {
      "id": "gen-postgres-snowflake",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["warehouse-read", "snowflake-analytics"],
      "request": {"prompt": "Read table public.orders from PostgreSQL connection warehouse-read and upsert it to Snowflake table ANALYTICS.ORDERS using connection snowflake-analytics."},
      "expect": {
        "activities": {"required": ["postgres.fetch", "sink.snowflake"], "forbidden": ["sink.postgres", "snowflake.fetch"]},
        "configs": [
          {"activityType": "postgres.fetch", "contains": {"table": "public.orders"}},
          {"activityType": "sink.snowflake", "contains": {"table": "ANALYTICS.ORDERS", "mode": "upsert"}}
        ]
      }
    },
    {
      "id": "gen-sheets-filter-postgres",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-google", "warehouse-read"],
      "request": {"prompt": "Using Google connection eval-google, import range Active!A:Z from spreadsheet sheet-eval-001, keep rows with enabled equal to true, and load them through Postgres connection warehouse-read into table crm.active_accounts."},
      "expect": {
        "activities": {"required": ["gsheets.fetch", "transform.filter", "sink.postgres"], "forbidden": ["sink.gsheets", "postgres.fetch"]},
        "configs": [
          {"activityType": "gsheets.fetch", "contains": {"spreadsheetId": "sheet-eval-001", "range": "Active!A:Z"}},
          {"activityType": "sink.postgres", "contains": {"table": "crm.active_accounts"}}
        ]
      }
    },
    {
      "id": "gen-kafka-dedupe-iceberg",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-kafka", "eval-iceberg"],
      "request": {"prompt": "Using Kafka connection eval-kafka, consume topic orders.v1, deduplicate on order_id keeping the latest record, then append through Iceberg connection eval-iceberg to table lake.orders."},
      "expect": {
        "activities": {"required": ["kafka.fetch", "transform.dedupe", "sink.iceberg"], "forbidden": ["sink.kafka", "iceberg.fetch"]},
        "configs": [
          {"activityType": "kafka.fetch", "contains": {"topic": "orders.v1"}},
          {"activityType": "transform.dedupe", "contains": {"key": "order_id"}},
          {"activityType": "sink.iceberg", "contains": {"table": "lake.orders"}}
        ]
      }
    },
    {
      "id": "gen-s3-parse-mongodb",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-s3", "reporting-mongo"],
      "request": {"prompt": "Using S3 connection eval-s3, read newline-delimited JSON from bucket eval-landing at key events/2026-08-01.jsonl, parse each JSON record, and write through MongoDB connection reporting-mongo to collection reporting.events."},
      "expect": {
        "activities": {"required": ["s3.fetch", "transform.parse", "sink.mongodb"], "forbidden": ["sink.s3", "mongodb.fetch"]},
        "configs": [
          {"activityType": "s3.fetch", "contains": {"bucket": "eval-landing", "key": "events/2026-08-01.jsonl"}},
          {"activityType": "sink.mongodb", "contains": {"collection": "reporting.events"}}
        ]
      }
    },
    {
      "id": "gen-zendesk-dedupe-sheets",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-zendesk", "eval-google"],
      "request": {"prompt": "Using Zendesk connection eval-zendesk, fetch tickets, remove duplicate tickets by id keeping the first, and export through Google connection eval-google to sheet Tickets in spreadsheet sheet-eval-002."},
      "expect": {
        "activities": {"required": ["zendesk.fetch", "transform.dedupe", "sink.gsheets"]},
        "configs": [
          {"activityType": "transform.dedupe", "contains": {"key": "id", "keep": "first"}},
          {"activityType": "sink.gsheets", "contains": {"spreadsheetId": "sheet-eval-002", "sheetName": "Tickets"}}
        ]
      }
    },
    {
      "id": "gen-mysql-rename-clickhouse",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["shop-mysql", "clickhouse-analytics"],
      "request": {"prompt": "Using MySQL connection shop-mysql, read table shop.customers, rename column emailAddress to email, then write through ClickHouse connection clickhouse-analytics to table mart.customers."},
      "expect": {
        "activities": {"required": ["mysql.fetch", "transform.rename", "sink.clickhouse"], "forbidden": ["sink.mysql"]},
        "configs": [
          {"activityType": "mysql.fetch", "contains": {"table": "shop.customers"}},
          {"activityType": "sink.clickhouse", "contains": {"table": "mart.customers"}}
        ]
      }
    },
    {
      "id": "gen-sftp-contract-records",
      "category": "generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": ["eval-sftp"],
      "request": {"prompt": "Using SFTP connection eval-sftp, import CSV file /exports/accounts.csv, enforce a data contract requiring account_id and status, and store the records in DataFlow."},
      "expect": {
        "activities": {"required": ["sftp.fetch", "transform.contract", "sink.records"], "forbidden": ["sink.sftp"]},
        "configs": [{"activityType": "sftp.fetch", "contains": {"path": "/exports/accounts.csv"}}]
      }
    },
    {
      "id": "refine-insert-dedupe",
      "category": "refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": ["eval-s3"],
      "request": {
        "prompt": "Before filtering, remove duplicate posts using id and keep the first record. Leave all existing node settings unchanged.",
        "definition": {
          "trigger": {"type": "manual"},
          "nodes": [
            {"id": "source", "type": "source", "activityType": "http.fetch", "config": {"url": "https://api.example.test/posts"}},
            {"id": "filter", "type": "transform", "activityType": "transform.filter", "config": {"predicate": "r.userId === 1"}},
            {"id": "sink", "type": "sink", "activityType": "sink.s3", "config": {"bucket": "eval-data", "key": "posts.json", "format": "json"}}
          ],
          "edges": [{"source": "source", "target": "filter"}, {"source": "filter", "target": "sink"}]
        }
      },
      "expect": {
        "activities": {"required": ["transform.dedupe"]},
        "configs": [{"activityType": "transform.dedupe", "contains": {"key": "id", "keep": "first"}}],
        "preserve": {"nodes": [{"id": "source"}, {"id": "filter"}, {"id": "sink"}]}
      }
    },
    {
      "id": "refine-change-filter",
      "category": "refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": ["eval-s3"],
      "request": {
        "prompt": "Change only the filter to keep rows where userId equals 2.",
        "definition": {
          "trigger": {"type": "manual"},
          "nodes": [
            {"id": "source", "type": "source", "activityType": "http.fetch", "config": {"url": "https://api.example.test/posts"}},
            {"id": "filter", "type": "transform", "activityType": "transform.filter", "config": {"predicate": "r.userId === 1"}},
            {"id": "sink", "type": "sink", "activityType": "sink.s3", "config": {"bucket": "eval-data", "key": "posts.json"}}
          ],
          "edges": [{"source": "source", "target": "filter"}, {"source": "filter", "target": "sink"}]
        }
      },
      "expect": {
        "activities": {"required": ["transform.filter"]},
        "preserve": {"nodes": [{"id": "source"}, {"id": "sink"}], "edges": true}
      }
    },
    {
      "id": "refine-change-s3-key",
      "category": "refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": ["warehouse-read", "eval-s3"],
      "request": {
        "prompt": "Change only the S3 object key to archive/orders.json.",
        "definition": {
          "trigger": {"type": "manual"},
          "nodes": [
            {"id": "source", "type": "source", "activityType": "postgres.fetch", "config": {"table": "public.orders"}},
            {"id": "sink", "type": "sink", "activityType": "sink.s3", "config": {"bucket": "eval-data", "key": "orders.json", "format": "json"}}
          ],
          "edges": [{"source": "source", "target": "sink"}]
        }
      },
      "expect": {
        "configs": [{"activityType": "sink.s3", "contains": {"bucket": "eval-data", "key": "archive/orders.json", "format": "json"}}],
        "preserve": {"nodes": [{"id": "source"}], "edges": true}
      }
    },
    {
      "id": "refine-add-select",
      "category": "refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": ["shop-mysql", "snowflake-analytics"],
      "request": {
        "prompt": "Add a select transform before the sink that keeps only id, total, and created_at.",
        "definition": {
          "trigger": {"type": "manual"},
          "nodes": [
            {"id": "source", "type": "source", "activityType": "mysql.fetch", "config": {"table": "shop.orders"}},
            {"id": "sink", "type": "sink", "activityType": "sink.snowflake", "config": {"table": "ANALYTICS.ORDERS"}}
          ],
          "edges": [{"source": "source", "target": "sink"}]
        }
      },
      "expect": {
        "activities": {"required": ["transform.select"]},
        "preserve": {"nodes": [{"id": "source"}, {"id": "sink"}]}
      }
    },
    {
      "id": "refine-preserve-branch",
      "category": "refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": ["eval-s3"],
      "request": {
        "prompt": "Change only the webhook URL to https://hooks.example.test/pipeline-alerts.",
        "definition": {
          "trigger": {"type": "manual"},
          "nodes": [
            {"id": "source", "type": "source", "activityType": "http.fetch", "config": {"url": "https://api.example.test/orders"}},
            {"id": "fork", "type": "fork", "activityType": "flow.fork", "config": {}},
            {"id": "store", "type": "sink", "activityType": "sink.s3", "config": {"bucket": "eval-data", "key": "orders.json"}},
            {"id": "alert", "type": "sink", "activityType": "sink.webhook", "config": {"url": "https://hooks.example.test/old"}}
          ],
          "edges": [{"source": "source", "target": "fork"}, {"source": "fork", "target": "store"}, {"source": "fork", "target": "alert"}]
        }
      },
      "expect": {
        "activities": {"required": ["flow.fork", "sink.webhook"]},
        "configs": [{"activityType": "sink.webhook", "contains": {"url": "https://hooks.example.test/pipeline-alerts"}}],
        "preserve": {"nodes": [{"id": "source"}, {"id": "fork"}, {"id": "store"}], "edges": true},
        "graph": {"minOutDegree": 2}
      }
    },
    {
      "id": "ambiguous-missing-destination",
      "category": "ambiguity",
      "endpoint": "/api/ai/generate",
      "request": {"prompt": "Fetch yesterday's completed orders and clean them up."},
