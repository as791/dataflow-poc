    { "id": "clickhouse", "type": "sink", "activityType": "sink.clickhouse", "config": { "connectionId": "clickhouse-connection", "collection": "orders", "columns": [{ "name": "id", "type": "BIGINT" }, { "name": "status", "type": "STRING" }, { "name": "updated_at", "type": "TIMESTAMP(3)" }] } }
